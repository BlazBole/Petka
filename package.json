  },
  "dependencies": {
    "@next/env": "^16.4.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "saxes": "^6.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
